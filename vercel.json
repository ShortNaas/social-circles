{
  "buildCommand": "pnpm install && pnpm --filter @workspace/social-circle run build",
  "outputDirectory": "artifacts/social-circle/dist/public",
  "framework": null,
  "env": {
    "PORT": "3000",
    "BASE_PATH": "/"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-APP-NAME.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
