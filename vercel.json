{
  "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @workspace/social-circle run build",
  "outputDirectory": "artifacts/social-circle/dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "[https://social-circles-api-3ism.onrender.com](https://social-circles-api-3ism.onrender.com)"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}